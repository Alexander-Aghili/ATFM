default edge line: (path: square, corners: rounded)
style runtime fill: #e8f1fa border: #37618a text: (color: #172c42)
style control fill: #fff0df border: #af702f text: (color: #513416)
style data fill: #eaf5ed border: #50815c text: (color: #203d28)
style evidence fill: #f0eafa border: #8060a5 text: (color: #38244d)
style external fill: #f1f3f5 border: #78838d text: (color: #29333c)

node entry "Composition roots / scripts/run_proxy.py, run_board.py / run_control.py; config and lifecycle" (wrap: 39) style: runtime gap: wide
node online "Online orchestration / proxy, sidecar, board/service / control/loop and optional adapters" (wrap: 39) style: runtime gap: wide right of entry
node external "External dependencies / Harness, HTTP serving, metrics / Optional Redis and LMCache services" (wrap: 39) style: external gap: wide right of online
node models "Forecast and control libraries / board/predictors and forecaster / control/gdp, touch, replica" (wrap: 39) style: runtime gap: wide below entry
node contracts "Shared contracts / schema/events, forecast, trace / control/directives; bus protocol" (wrap: 39) style: data gap: wide right of models
node traces "Data preparation / collect + traces / Real adapters and synthetic generation" (wrap: 39) style: data gap: wide right of contracts
node simulation "Closed-loop simulator / sim/core, engine, policies / Forecast and placement policy arms" (wrap: 39) style: runtime gap: wide below models
node experiments "Separate workspace package / experiments/src/atfm_experiments / H1, H2, load, profiling, observability" (wrap: 39) style: evidence gap: wide right of simulation
node tests "Verification / tests by package + references / Behavior, isolation, scaling, structure" (wrap: 39) style: evidence gap: wide right of experiments
edge entry -> online "construct" (size: small) from: right to: left
edge online -> external "protocols" (size: small) from: right to: left
edge online -> contracts "typed data" (size: small) from: bottom to: top
edge online -> models "invoke" (size: small) from: bottom to: top
edge traces -> contracts "TraceTable" (size: small) from: left to: right
edge simulation -> models "reuse models" (size: small) from: top to: bottom
edge experiments -> simulation "run trials" (size: small) from: left to: right
edge experiments -> tests "checked by" (size: small) from: right to: left
edge contracts -> experiments "shared formats" (size: small) from: bottom to: top
