diagram theme: print
default edge line: (path: square, corners: rounded)
style shared fill: #e5f1e9 border: #32714b
style unique fill: #e8eff6 border: #245b85
node a "Request A / logical blocks 0, 1, 2"
node b "Request B / logical blocks 0, 1, 2" right of a
node shared "Physical blocks 7 and 2 / identical prefix; refcount 2" below a and b style: shared
node taila "Physical block 9 / A suffix" left of shared style: unique
node tailb "Physical block 4 / B suffix" right of shared style: unique
edge a -> shared from: bottom to: top
edge b -> shared from: bottom to: top
edge a -> taila from: left to: top
edge b -> tailb from: right to: top
