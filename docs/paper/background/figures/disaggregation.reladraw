diagram theme: print
default edge line: (path: square, corners: rounded)
style work fill: #e8eff6 border: #245b85
node router "Router / choose both pools"
node prefill "Prefill workers / prompt processing" below router style: work
node decode "Decode workers / token generation" right of prefill style: work
node output "Streaming output / first token and later tokens" above decode
edge router -> prefill "prompt" from: bottom to: top
edge prefill -> decode "KV tensors + metadata" from: right to: left
edge decode -> output from: top to: bottom
edge router -> output "request identity" from: right to: left line: (pattern: dashed)
